# =======================================================================
# 🚕 Robotaxi Finance Analytics - Standard .gitignore
# =======================================================================

# 📊 Large Data Files (Ignore all CSV/Excel data to avoid GitHub size limit issues)
*.csv
*.xlsx
cleaned_data/

# 🤖 Machine Learning Model Artifacts (Serialized binary weights)
models/
*.pkl
*.joblib
*.pb
*.h5

# 🐍 Python Virtual Environments & Cache Directories
__pycache__/
*.py[cod]
*$py.class
*.so
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# 📓 Jupyter Notebook State Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ⚙️ OS & Editor Temporary Files
.DS_Store
Thumby.db
ehthumbs.db
desktop.ini
.vscode/
.idea/

# 🤖 Agent-Specific Temporal Folders
.gemini/
